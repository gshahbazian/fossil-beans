{
  "name": "fossil-beans",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "check": "pnpm cf-typegen && tsc --noEmit && oxlint",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "cf-typegen": "wrangler types --env-file /dev/null",
    "postinstall": "pnpm run cf-typegen",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fossil-beans --local",
    "db:migrate:remote": "wrangler d1 migrations apply fossil-beans --remote",
    "db:studio": "drizzle-kit studio",
    "seed:teams:local": "./scripts/insert-teams.sh --local",
    "seed:teams:remote": "./scripts/insert-teams.sh --remote",
    "seed:games:local": "./scripts/insert-games.sh --local",
    "seed:games:remote": "./scripts/insert-games.sh --remote",
    "format:write": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "posthog-js": "^1.447.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@12.11.2"
}
