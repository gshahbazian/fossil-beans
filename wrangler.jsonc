{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fossil-beans",
  // From 2026-08-04 on, `nodejs_compat` and `nodejs_compat_v2` are enabled by
  // the compatibility date itself, so no `compatibility_flags` entry is needed.
  "compatibility_date": "2026-08-04",
  "main": "./src/server-entry.ts",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  // Native Workers Cache: sits in front of this Worker and caches responses per
  // their `Cloudflare-CDN-Cache-Control` header, serving hits without running
  // the Worker. Each deployment gets its own cache; the first request fills it
  // with that version's HTML. Data inserts invalidate it via `cache.purge()`.
  "cache": { "enabled": true, "cross_version_cache": false },
  "triggers": {
    // Every 10 min from 3:00pm through 1:30am PST (23:00–09:30 UTC). Crons only
    // run in UTC, so under PDT this runs an hour later in local time.
    "crons": ["*/10 23,0-8 * * *", "0,10,20,30 9 * * *"],
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fossil-beans",
      "database_id": "469df9d3-ce24-4e94-858c-7458fbdd82f5",
      "migrations_dir": "./drizzle",
    },
  ],
  "vars": {
    "NBA_GAME_LOG_URL": "https://stats.nba.com/stats/leaguegamelog",
    "NBA_BOX_SCORE_URL": "https://nba-prod-us-east-1-mediaops-stats.s3.amazonaws.com/NBA/liveData/boxscore",
    "NBA_SCOREBOARD_URL": "https://nba-prod-us-east-1-mediaops-stats.s3.amazonaws.com/NBA/liveData/scoreboard/todaysScoreboard_00.json",
  },
  // PURGE_SECRET is intentionally NOT declared here. A plaintext `vars` entry
  // overrides a `wrangler secret put` value on deploy, which would reset the
  // token to a known constant and leave the write endpoints open. Set it as a
  // secret in production (`wrangler secret put PURGE_SECRET`) and in `.dev.vars`
  // for local development (see `.dev.vars.example`).
}
